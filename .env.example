# Claude API キー（Claude Console で発行）。このファイルを .env.local という名前でコピーして値を入れる
ANTHROPIC_API_KEY=

# GAS → /api/fax/inbound の合言葉（16文字以上）
FAX_INBOUND_TOKEN=

# LINE（docs/line-setup.md の手順で取得。空のままならデモモード＝LINEには送らず記録だけ）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
